# All defaults work out of the box with a local Ollama. Override only if needed.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_KEEP_ALIVE=15s   # e.g. 30m to avoid the ~2 s model reload between questions
# EMBED_MODEL=bge-m3
# ANSWER_MODEL=qwen2.5:7b
# QDRANT_URL=http://localhost:6333   # unset -> Qdrant local mode at data/index/qdrant
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
